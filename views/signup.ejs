<!DOCTYPE html>
<html>
<head>
  <title>Sign Up</title>

  <!-- Link to your stylesheet for styling the page -->
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Page heading -->
  <h1>Create Account</h1>

  <!-- If there's a flash message (e.g. signup error), show it in red -->
  <% if (message.length > 0) { %>
    <p style="color:red"><%= message %></p>
  <% } %>

  <!-- Signup form that submits a POST request to /signup -->
  <form action="/signup" method="POST">
    <!-- Email input -->
    <input name="email" placeholder="Email" required><br>

    <!-- Password input -->
    <input type="password" name="password" placeholder="Password" required><br>

    <!-- Submit button -->
    <button type="submit">Sign Up</button>
  </form>

  <!-- Link back to homepage -->
  <a href="/">Home</a>
</body>
</html>
